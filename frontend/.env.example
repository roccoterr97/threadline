# Frontend environment — copy to .env.local and fill in.
# Both values are safe to expose in the browser: the database access rules make
# every table unreadable without the owner's login. The service-role key must NEVER
# appear in this folder or in any VITE_ variable.

# Supabase project address, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key (Project Settings -> API)
VITE_SUPABASE_ANON_KEY=
