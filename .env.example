# Copy to .env and fill in. Never commit .env.
#
# Every environment variable the project reads must be listed here with a
# comment. If a variable is not deployment-specific, it is a constant — put it
# in code, not here (see CLAUDE.md §5).
#
# The backend reads this file through get_settings() in
# backend/src/tracker/shared/config.py, which is the only place that touches the
# environment. On GitHub Actions the same values live in the repository's
# Actions secrets and variables instead of a file (`uv run tracker setup github`
# puts them there); on the alternative route, in the Claude cloud environment.
#
# Not here, on purpose: CLAUDE_CODE_OAUTH_TOKEN, the key `claude setup-token`
# makes for your Claude subscription. It goes only into your repository's
# Actions secrets; never write it into this file.

# --- Application ---------------------------------------------------------
# development | staging | production
APP_ENV=development
# debug | info | warning | error
LOG_LEVEL=info

# --- Database (Supabase) --------------------------------------------------
# Project address, exactly as Supabase shows it: https://<project-id>.supabase.co
SUPABASE_URL=
# Service key. Bypasses every access rule — used only by the Python jobs,
# never by the dashboard, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public key. Safe in the browser; on its own it reads nothing, because the
# access rules require a logged-in owner.
SUPABASE_ANON_KEY=

# --- Secrets -------------------------------------------------------------
# Encrypts the rotating Microsoft key and the IMAP app password stored in the
# database. Deliberately kept out of the database, so a copy of the database
# alone reveals nothing.
# Generate with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Owner identity ------------------------------------------------------
# Optional. The owner's own LinkedIn profile address, used to tell the owner's
# messages from everybody else's. Leave it (or LINKEDIN_ACCESS_TOKEN) empty and
# LinkedIn is skipped: the daily run reports "not configured" and is not marked
# as partly failed because of it.
OWNER_LINKEDIN_PROFILE_URL=
# Every address that belongs to the owner, comma-separated, so a message from
# one of them counts as outbound.
OWNER_EMAIL_ADDRESSES=

# --- Owner settings --------------------------------------------------------
# Everything below is optional: an empty line uses the default it names.
# They are read and checked when any command starts; a wrong value stops the
# command with one line naming the setting, never its value.
#
# Where the morning summary is sent: exactly one address. Python writes it into
# the summary file; the session sending the e-mail never chooses it.
# Default: the first address in OWNER_EMAIL_ADDRESSES.
SUMMARY_RECIPIENT=
# Your name as meetings you type yourself spell it, for when your address does
# not (jd123@… says nothing). Kept out of the company name read from an
# "Interview - <you> and <company>" calendar entry.
# Default: read from your addresses.
OWNER_DISPLAY_NAME=
# Your time zone, as an IANA name such as Europe/Rome or America/New_York. It
# decides what "today" is: due dates, overdue, time to chase, the summary's
# date, meeting times shown to the assistant, and the dashboard (copied into
# the database at the start of every daily run). Default: UTC.
OWNER_TIME_ZONE=
# Your days off, comma-separated (mon … sun, or full names), or "none". They
# are skipped when a follow-up date is counted in working days.
# Default: sat,sun.
OWNER_WEEKEND_DAYS=
# What Threadline calls itself in the summary and the command-line help.
# Default: Threadline.
PRODUCT_NAME=
# How every summary subject starts. The mailbox collector ignores mail whose
# subject starts with it, so Threadline never reads its own summary back.
# At least 3 characters. Default: [Threadline]
SUMMARY_SUBJECT_PREFIX=
# --- End of owner settings ------------------------------------------------

# --- LinkedIn ------------------------------------------------------------
# Optional (see OWNER_LINKEDIN_PROFILE_URL).
# Access key for LinkedIn's official Member Data Portability API (EU members).
# Generated by hand in the LinkedIn developer portal's OAuth Token Tools with
# the r_dma_portability_self_serve scope; must be re-generated when it expires.
LINKEDIN_ACCESS_TOKEN=
# The day that key stops working (YYYY-MM-DD). The daily run warns before it.
LINKEDIN_TOKEN_EXPIRES_ON=

# --- Mailboxes ------------------------------------------------------------
# Which mailboxes Threadline reads: outlook, imap, or both (comma-separated).
# At least one is required. "imap" covers Gmail, iCloud, Yahoo, Fastmail and
# any other mailbox that offers IMAP. The calendar is read from Outlook only.
# Default: outlook. `uv run tracker setup mailbox` fills in this whole block.
MAIL_SOURCES=
# The IMAP mailbox's provider: gmail, icloud, yahoo, fastmail or custom. For
# the first four the server is known; custom needs IMAP_HOST. Default: custom.
IMAP_PROVIDER=
# The IMAP server and port, only for a custom provider or an unusual server.
# Default: the provider's own server, port 993 (IMAP over TLS).
IMAP_HOST=
IMAP_PORT=
# The name the IMAP mailbox signs in with, usually its full address. Required
# when MAIL_SOURCES includes imap.
IMAP_USERNAME=
# The app password is deliberately NOT a setting: `tracker setup mailbox`
# checks it live and stores it encrypted in the database, under the name
# `imap_app_password:<IMAP_USERNAME>`.

# --- Sending the summary ---------------------------------------------------
# How the morning summary is sent: smtp (from your IMAP mailbox, with the same
# app password; works on GitHub Actions) or gmail_connector (the Gmail
# connector of a Claude cloud routine, the alternative route).
# Default: smtp when MAIL_SOURCES includes imap, else gmail_connector.
SUMMARY_DELIVERY=
# The server that sends mail and its port. Set by `tracker setup mailbox` for
# another provider; leave both empty otherwise. Default: the provider's own (Gmail smtp.gmail.com:465,
# iCloud smtp.mail.me.com:587, Yahoo smtp.mail.yahoo.com:465, Fastmail
# smtp.fastmail.com:465). Port 465 is TLS from the start; any other port is
# upgraded with STARTTLS before the password is sent.
SMTP_HOST=
SMTP_PORT=

# --- Microsoft mailbox ---------------------------------------------------
# Nothing to fill in here, on purpose. Microsoft hands back a *new* long-lived
# key on every renewal, so it cannot live in a file: it is kept encrypted in the
# database instead, under the name `microsoft_refresh_token`.
#
# Sign in once with:
#   cd backend && uv run tracker microsoft login
# It shows a short code to type on a Microsoft page, asks only for read-only
# mailbox access, and stores the key itself.
#
# To start again from scratch: `uv run tracker microsoft forget`, then log in.

# --- Microsoft sign-in application (begin) ---------------------------------
# Optional. Leave both commented out to use the defaults.
# The registered application the mailbox sign-in goes through. The default is
# the public one of the open-source ms-365-mcp-server; put your own here only
# if you registered one (see docs/setup-your-accounts.md). Changing it needs a
# new sign-in: `uv run tracker setup microsoft`.
# MICROSOFT_CLIENT_ID=
# Which Microsoft accounts may sign in: consumers (personal accounts such as
# Outlook.com and Hotmail, the default), common, organizations, or a directory id.
# MICROSOFT_TENANT=consumers
# --- Microsoft sign-in application (end) -----------------------------------

# --- Dashboard ------------------------------------------------------------
# Where the dashboard is published, with no trailing slash, for example
# https://<your-dashboard>.vercel.app . Leave it empty until it is
# published: the morning e-mail then carries no links rather than pointing at
# an address that is not yours.
DASHBOARD_BASE_URL=
